{
  "$schema": "../schemas/manifest.schema.json",
  "version": 1,
  "jobs": {
    // A process expected to stay alive.
    "local-api": {
      "kind": "service",
      "label": "dev.example.local-api",
      "description": "Local development API",
      "command": [
        "/opt/homebrew/bin/bun",
        "run",
        "src/index.ts"
      ],
      "workingDirectory": "~/src/local-api",
      "start": "login",
      "restart": "on-failure",
      "environment": {
        "NODE_ENV": "development"
      }
    },

    // A finite process executed every day at 03:00 local time.
    "daily-backup": {
      "kind": "task",
      "label": "dev.example.daily-backup",
      "command": ["~/.local/bin/backup"],
      "schedule": {
        "type": "calendar",
        "entries": [
          { "hour": 3, "minute": 0 }
        ]
      }
    },

    // Interval schedules are translated to launchd StartInterval.
    "refresh-cache": {
      "kind": "task",
      "label": "dev.example.refresh-cache",
      "command": ["~/.local/bin/refresh-cache"],
      "schedule": {
        "type": "interval",
        "every": "15m"
      }
    }
  }
}
