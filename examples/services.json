{
  "$schema": "../schemas/manifest.schema.json",
  "version": 1,
  "jobs": {
    "local-api": {
      "kind": "service",
      "label": "dev.example.local-api",
      "description": "Local development API",
      "comment": "A process expected to stay alive.",
      "command": [
        "/opt/homebrew/bin/bun",
        "run",
        "src/index.ts"
      ],
      "workingDirectory": "~/src/local-api",
      "start": "login",
      "restart": "on-failure",
      "environment": {
        "NODE_ENV": "development"
      }
    },
    "daily-backup": {
      "kind": "task",
      "label": "dev.example.daily-backup",
      "comment": "A finite process executed every day at 03:00 local time.",
      "command": ["~/.local/bin/backup"],
      "schedule": {
        "type": "calendar",
        "entries": [
          { "hour": 3, "minute": 0 }
        ]
      }
    },
    "refresh-cache": {
      "kind": "task",
      "label": "dev.example.refresh-cache",
      "comment": "Interval schedules are translated to launchd StartInterval.",
      "command": ["~/.local/bin/refresh-cache"],
      "schedule": {
        "type": "interval",
        "every": "15m"
      }
    }
  }
}
