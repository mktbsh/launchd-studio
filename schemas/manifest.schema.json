{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchd-studio.dev/schemas/manifest-v1.json",
  "title": "Launchd Studio manifest",
  "description": "Intent-based definitions for macOS user LaunchAgents.",
  "type": "object",
  "required": [
    "version",
    "jobs"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "jobs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/service"
          },
          {
            "$ref": "#/$defs/task"
          }
        ]
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?:/|~/)",
      "description": "An absolute POSIX path or a path beginning with ~/"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "#/$defs/path"
        }
      ],
      "items": {
        "type": "string"
      },
      "description": "argv passed directly to launchd. A shell is not inserted."
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stdout": {
          "$ref": "#/$defs/path"
        },
        "stderr": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "commonProperties": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "description": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "scope": {
          "const": "user"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "workingDirectory": {
          "$ref": "#/$defs/path"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "logs": {
          "$ref": "#/$defs/logs"
        }
      }
    },
    "service": {
      "title": "Long-running service",
      "type": "object",
      "required": [
        "kind",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "service"
        },
        "label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "description": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "scope": {
          "const": "user"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "workingDirectory": {
          "$ref": "#/$defs/path"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "logs": {
          "$ref": "#/$defs/logs"
        },
        "start": {
          "enum": [
            "login",
            "manual"
          ],
          "default": "login"
        },
        "restart": {
          "enum": [
            "never",
            "on-failure",
            "always"
          ],
          "default": "on-failure"
        },
        "throttleIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 10
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "start"
            ],
            "properties": {
              "start": {
                "const": "manual"
              }
            }
          },
          "then": {
            "required": [
              "restart"
            ],
            "properties": {
              "restart": {
                "const": "never"
              }
            }
          }
        }
      ]
    },
    "calendarEntry": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "weekday": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      }
    },
    "intervalSchedule": {
      "type": "object",
      "required": [
        "type",
        "every"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "interval"
        },
        "every": {
          "type": "string",
          "pattern": "^\\d+(?:s|m|h|d)(?:\\d+(?:s|m|h|d))*$",
          "examples": [
            "30s",
            "15m",
            "1h30m"
          ]
        }
      }
    },
    "calendarSchedule": {
      "type": "object",
      "required": [
        "type",
        "entries"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "calendar"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/calendarEntry"
          }
        }
      }
    },
    "task": {
      "title": "Finite task",
      "type": "object",
      "required": [
        "kind",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "task"
        },
        "label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "description": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "scope": {
          "const": "user"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "workingDirectory": {
          "$ref": "#/$defs/path"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "logs": {
          "$ref": "#/$defs/logs"
        },
        "runAtLoad": {
          "type": "boolean",
          "default": false
        },
        "schedule": {
          "oneOf": [
            {
              "$ref": "#/$defs/intervalSchedule"
            },
            {
              "$ref": "#/$defs/calendarSchedule"
            }
          ]
        }
      }
    }
  }
}
